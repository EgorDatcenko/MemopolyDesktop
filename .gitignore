```gitignore
# Compiled Java classes
*.class
*.jar
*.war
*.ear

# Build directories
target/
build/
dist/

# Dependencies
lib/
libs/
dependency-reduced-pom.xml

# IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak

# Environment
.env
.env.local
*.env.*

# OS generated files
.DS_Store
Thumbs.db
```